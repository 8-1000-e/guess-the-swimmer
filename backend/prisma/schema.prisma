generator client {
  moduleFormat = "cjs"
  provider     = "prisma-client"
  output       = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Swimmer {
  login       String   @id
  ftId        String?
  displayName String?
  ftPfpUrl    String?
  staff       Boolean  @default(false)
  poolMonth   String?
  poolYear    Int?
  createdAt   DateTime @default(now())
  syncedAt    DateTime @default(now())

  user   User?
  rounds Round[]
}

model User {
  ftId     String  @id
  login    String  @unique
  name     String
  ftPfpUrl String?
  campus   String?

  totalTryCount Int @default(0)

  createdAt DateTime @default(now())

  swimmer       Swimmer        @relation(fields: [login], references: [login])
  rounds        Round[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  ftId      String
  user      User     @relation(fields: [ftId], references: [ftId], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([ftId])
}

model Round {
  id       String @id @default(uuid())
  player   User   @relation(fields: [playerId], references: [ftId], onDelete: Cascade)
  playerId String

  target      Swimmer @relation(fields: [targetLogin], references: [login])
  targetLogin String

  assignedOn DateTime    @db.Date
  status     RoundStatus @default(playing)
  attempts   Int         @default(0)

  signToken          String?   @unique
  signTokenExpiresAt DateTime?

  solvedAt    DateTime?
  validatedAt DateTime?
  createdAt   DateTime  @default(now())

  guesses Guess[]

  @@unique([playerId, assignedOn])
  @@index([playerId, status])
  @@index([targetLogin, status])
}

enum RoundStatus {
  playing
  solved
  validated
  expired
}

model Guess {
  id      String @id @default(uuid())
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId String

  value  String
  result Json

  createdAt DateTime @default(now())

  @@index([roundId, createdAt])
}
